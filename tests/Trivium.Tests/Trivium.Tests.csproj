<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;IDE0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Trivium/Trivium.csproj" />
    <ProjectReference Include="../../src/Trivium.AspNetCore/Trivium.AspNetCore.csproj" />
    <ProjectReference Include="../../src/Trivium.Hosting/Trivium.Hosting.csproj" />
    <ProjectReference Include="../../src/Trivium.OpenTelemetry/Trivium.OpenTelemetry.csproj" />
    <ProjectReference Include="../../src/Trivium.Testing/Trivium.Testing.csproj" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
